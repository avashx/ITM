# ==============================================================================
# IT Monitor - Environment Configuration
# Copy this file to `.env` and fill in values. NEVER commit the real .env.
# Every key below is optional unless marked REQUIRED - sensible defaults apply.
# See API_KEYS.md for where to obtain each credential and its free-tier limits.
# ==============================================================================

# ---- Core server -------------------------------------------------------------
# Port the Express + Socket.io server listens on
PORT=3000
# Environment: development | production
NODE_ENV=development
# IANA timezone used for cron schedules and day bucketing (Delhi = Asia/Kolkata)
TZ=Asia/Kolkata

# ---- MongoDB (REQUIRED) ------------------------------------------------------
# Local MongoDB:    mongodb://127.0.0.1:27017/itmonitor
# MongoDB Atlas M0: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/itmonitor
MONGODB_URI=mongodb://127.0.0.1:27017/itmonitor

# ---- Module 1: Uptime monitor ------------------------------------------------
# Master switch for the scheduler (true/false). Leave false while seeding.
MONITOR_ENABLED=true
# Cron expression for check cycles. Default: every 5 minutes (respectful rate).
CHECK_CRON=*/5 * * * *
# Per-request timeout in milliseconds
CHECK_TIMEOUT_MS=10000
# How many endpoints are probed concurrently within a cycle (keep small; be polite)
CHECK_CONCURRENCY=8
# Consecutive failures before an incident is opened + alert sent
FAIL_THRESHOLD=3
# Latency above this (ms) marks a service "degraded"
DEGRADED_LATENCY_MS=4000
# Days of raw per-check history to retain (daily rollups are kept forever)
CHECK_RETENTION_DAYS=30
# Days before certificate expiry to start warning
SSL_WARN_DAYS=30
# Identify ourselves honestly to the servers we ping
MONITOR_USER_AGENT=GNCTD-IT-Monitor/1.0 (+service-health-check; contact: it-monitor@delhi.gov.in)

# DEMO/OFFLINE MODE: when true, checks are SIMULATED (no real HTTP traffic).
# Use for demos, development without internet, or restricted networks.
# The UI shows a clear "SIMULATED" banner when this is on.
SIMULATE_CHECKS=false

# ---- Email alerts (Nodemailer SMTP) -------------------------------------------
# Leave SMTP_HOST empty to disable email (alerts still appear on dashboard/socket).
# Gmail:  smtp.gmail.com:465 (secure=true) with an App Password - see API_KEYS.md
# Brevo:  smtp-relay.brevo.com:587 (secure=false) - 300 emails/day free
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM="IT Monitor <alerts@example.com>"
# Comma-separated recipients for outage/SSL/surge alerts
ALERT_EMAIL_TO=

# ---- Module 2: Grievances -----------------------------------------------------
# SLA defaults (days) modelled on PGMS Delhi norms: 7-day first response,
# 30-day resolution, SOS priority 3 days. Override per department in code/config.
SLA_RESPONSE_DAYS=7
SLA_RESOLUTION_DAYS=30
SLA_SOS_DAYS=3

# ---- Module 3: Correlation engine ---------------------------------------------
# Cron for the nightly correlation scan (default 02:15 IST daily)
CORRELATION_CRON=15 2 * * *
# Minimum spike ratio (observed/baseline) and z-score to record an insight
CORRELATION_MIN_RATIO=1.3
CORRELATION_MIN_Z=2.0
# Hours after an outage begins that we scan for complaint spikes
CORRELATION_WINDOW_HOURS=48

# ---- Admin --------------------------------------------------------------------
# If set, mutating API calls (create/update/delete service, import grievances,
# run correlation) must send header:  X-Admin-Key: <this value>
ADMIN_API_KEY=

# ---- Assistant panel (optional) ------------------------------------------------
# With a key, the in-app assistant answers free-form questions using Claude,
# grounded ONLY in a live snapshot of this platform's own data.
# WITHOUT a key it still works: a deterministic responder answers the same
# questions from the same data (clearly labelled "rule-based" in the UI).
# Get a key at https://console.anthropic.com - see API_KEYS.md for cost notes.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-4-8

# ---- External data (all optional; see API_KEYS.md) -----------------------------
# data.gov.in / delhi.data.gov.in Open Government Data API key (free registration)
DATA_GOV_IN_API_KEY=
# MapTiler key if you prefer MapTiler basemaps over OSM (free tier available)
MAPTILER_KEY=
